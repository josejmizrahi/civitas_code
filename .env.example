# =============================================================================
# CIVITAS - Variables de entorno
# Copia a .env y rellena con los valores de tu proyecto Supabase.
# No subas .env a git (está en .gitignore).
# =============================================================================

# --- Supabase (cliente Vite — expuestas al browser) ---
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# --- Push Notifications (VAPID) ---
# Genera con: npx web-push generate-vapid-keys --json
# La public key va aquí (frontend). La private key va en Supabase secrets.
VITE_VAPID_PUBLIC_KEY=

# --- Variables CIVITAS (Vercel integration) ---
CIVITAS_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
CIVITAS_SUPABASE_ANON_KEY=
CIVITAS_SUPABASE_SERVICE_ROLE_KEY=
CIVITAS_SUPABASE_JWT_SECRET=
CIVITAS_SUPABASE_PUBLISHABLE_KEY=
CIVITAS_SUPABASE_SECRET_KEY=
CIVITAS_VITE_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
CIVITAS_VITE_PUBLIC_SUPABASE_ANON_KEY=
CIVITAS_VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Postgres (conexión directa) ---
CIVITAS_POSTGRES_DATABASE=postgres
CIVITAS_POSTGRES_HOST=db.TU_PROJECT_REF.supabase.co
CIVITAS_POSTGRES_PASSWORD=
CIVITAS_POSTGRES_USER=postgres
CIVITAS_POSTGRES_URL=postgres://postgres.TU_PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
CIVITAS_POSTGRES_URL_NON_POOLING=postgres://postgres.TU_PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
CIVITAS_POSTGRES_PRISMA_URL=postgres://postgres.TU_PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true

# =============================================================================
# SECRETOS DE EDGE FUNCTIONS
# Estos NO van en .env — se configuran en Supabase Dashboard:
#   Dashboard > Edge Functions > [nombre-función] > Secrets
# Se documentan aquí como referencia.
# =============================================================================

# --- send-email (Edge Function) ---
# RESEND_API_KEY=re_...           # Obtener en https://resend.com
# FROM_EMAIL=notificaciones@civitas.app
# SITE_URL=https://civitas-code.vercel.app

# --- send-push (Edge Function) ---
# VAPID_PUBLIC_KEY=               # Misma que VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=              # Generada junto con la public key
# VAPID_SUBJECT=mailto:soporte@civitas.app

# --- fintoc-checkout / fintoc-transfer / fintoc-webhook (Edge Functions) ---
# FINTOC_SECRET_KEY=              # API secret key del proveedor financiero
# FINTOC_JWS_SIGNATURE=           # Firma JWS para transferencias (opcional)

# =============================================================================
# TESTS E2E/RLS (opcional)
# =============================================================================
# TEST_SUPABASE_URL=
# TEST_SUPABASE_ANON_KEY=
# TEST_MEMBER_EMAIL=
# TEST_MEMBER_PASSWORD=
# TEST_ADMIN_EMAIL=
# TEST_ADMIN_PASSWORD=
# TEST_OTHER_EMAIL=
# TEST_OTHER_PASSWORD=
